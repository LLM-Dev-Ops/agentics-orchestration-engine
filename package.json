{
  "name": "@agentics/simulation-engine",
  "version": "0.1.0",
  "description": "Deterministic enterprise decision simulation engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:determinism": "vitest run test/determinism",
    "test:unit": "vitest run test/unit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "simulation",
    "enterprise",
    "deterministic",
    "policy",
    "erp"
  ],
  "author": "Agentics Platform Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "fast-check": "^3.0.0"
  }
}
