{
  "name": "@agentics/orchestration-engine",
  "version": "0.1.0",
  "description": "Agentics orchestration engine — Layer 4 conductor service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:determinism": "vitest run test/determinism",
    "test:unit": "vitest run test/unit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "check:no-mock-cores": "node scripts/check-no-mock-cores.mjs",
    "validate": "npm run typecheck && npm run lint && npm run check:no-mock-cores && npm run test"
  },
  "keywords": [
    "simulation",
    "enterprise",
    "deterministic",
    "policy",
    "erp"
  ],
  "author": "Agentics Platform Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@agentics/contracts": "file:packages/agentics-contracts",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "claude-flow": "^3.0.0-alpha.179",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "bundledDependencies": [
    "@agentics/contracts"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "fast-check": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
